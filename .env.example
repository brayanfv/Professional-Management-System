# Docker Compose and local PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=professional_management
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_PORT=8080

# Security configuration. Replace before any non-local use.
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRATION=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Login protection. The current limiter is in-memory and per direct client IP.
# A production reverse proxy must not forward client IP headers until it is trusted.
LOGIN_RATE_LIMIT_CAPACITY=10
LOGIN_RATE_LIMIT_REFILL_TOKENS=10
LOGIN_RATE_LIMIT_REFILL_PERIOD=1m

# Browser sessions are HttpOnly cookies. The dev profile defaults to Secure=false
# for localhost HTTP; production defaults to Secure=true and requires HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# Initial administrator bootstrap. This password is hashed on first startup.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
