# Copy to .env.production on the target host, protect it with chmod 600, and
# provide real deployment values only through the host's protected environment.
PUBLIC_HOST=localhost
NEXT_PUBLIC_API_URL=https://localhost

DB_NAME=professional_management
DB_USERNAME=replace-with-production-database-user
DB_PASSWORD=replace-with-production-database-password

JWT_SECRET=replace-with-random-secret-of-at-least-32-characters
JWT_EXPIRATION=3600
CORS_ALLOWED_ORIGINS=https://localhost
SESSION_COOKIE_SAME_SITE=Lax

# Set all three values only for the first intended administrator bootstrap.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-initial-administrator-password

LOGIN_RATE_LIMIT_CAPACITY=10
LOGIN_RATE_LIMIT_REFILL_TOKENS=10
LOGIN_RATE_LIMIT_REFILL_PERIOD=1m
