@baseUrl = http://localhost:8080/api

# The HTTP client must preserve cookies between requests. First call /auth/me
# once to receive XSRF-TOKEN, then copy its cookie value here for POST/PUT/PATCH/DELETE.
@csrfToken = replace-with-XSRF-TOKEN-cookie-value

### Establish the CSRF cookie (returns 401 until login)
GET {{baseUrl}}/auth/me

### Login (the bootstrap admin must be configured through environment variables)
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "email": "admin@example.com",
  "password": "replace-with-password"
}

### Current authenticated user (uses the HttpOnly pm_session cookie)
GET {{baseUrl}}/auth/me

### Logout (expires the HttpOnly session cookie)
POST {{baseUrl}}/auth/logout
X-XSRF-TOKEN: {{csrfToken}}

### Dashboard summary
GET {{baseUrl}}/dashboard/summary

### Professionals by department
GET {{baseUrl}}/dashboard/professionals-by-department

### Professionals by position
GET {{baseUrl}}/dashboard/professionals-by-position

### Recent professionals
GET {{baseUrl}}/dashboard/recent-professionals?limit=5

### Create department
POST {{baseUrl}}/departments
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Technology",
  "description": "Technology department"
}

### Create position
POST {{baseUrl}}/positions
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Software Developer",
  "description": "Responsible for software development"
}

### Create professional
POST {{baseUrl}}/professionals
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Brayan Favarin",
  "birthDate": "2004-11-17",
  "departmentId": 1,
  "positionId": 1
}

### List professionals with filters
GET {{baseUrl}}/professionals?page=0&size=10&search=Brayan&status=ACTIVE&departmentId=1&sort=name,asc

### Update professional status
PATCH {{baseUrl}}/professionals/1/status
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{ "status": "INACTIVE" }

### Create a contact for a professional
POST {{baseUrl}}/professionals/1/contacts
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "type": "EMAIL",
  "value": "brayan@example.com",
  "label": "Professional"
}

### List a professional's contacts
GET {{baseUrl}}/professionals/1/contacts

### Update a contact
PUT {{baseUrl}}/professionals/1/contacts/1
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "type": "MOBILE",
  "value": "+55 48 99999-9999",
  "label": "Personal"
}
